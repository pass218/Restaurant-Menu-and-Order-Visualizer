override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Ansible Artifacts
*.retry
ansible.log
ansible-debug.log
.ansible/

# Kubernetes / Helm
*.kubeconfig
kubeconfig*
!kubeconfig.example
*.tgz
*.lock

