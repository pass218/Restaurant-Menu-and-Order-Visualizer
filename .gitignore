# Node / NPM
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Test & Coverage Outputs
coverage/
.nyc_output/
*.lcov
test-reports/
